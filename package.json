{
  "name": "smart-home-auto-layout-demo",
  "version": "0.1.13",
  "author": "QoneLab",
  "private": true,
  "type": "module",
  "description": "QoneHome·智能家电门店管理系统：全屋智能门店管理、户型布点与报价（Vue 3 + Node.js + Three.js）",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,magenta \"vite --host 127.0.0.1\" \"node server/index.mjs\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node server/index.mjs",
    "dev:app": "node scripts/serve-app.mjs",
    "app": "node scripts/serve-app.mjs",
    "build": "vite build",
    "build:rules": "esbuild src/browser/rules-entry.ts --bundle --format=iife --global-name=SmartHomeRules --outfile=app/rules.bundle.js --loader:.json=json",
    "preview": "vite preview --host 127.0.0.1",
    "prestart": "npm run build && npm run build:rules",
    "start": "node server/index.mjs",
    "desktop": "npm run build && npm run build:rules && electron --no-sandbox --disable-gpu --disable-gpu-sandbox --disable-software-rasterizer --disable-features=RendererCodeIntegrity,WinSboxDisableExtensionPoints electron/main.cjs",
    "desktop:pack": "node scripts/pack-desktop.mjs",
    "clean:release": "node scripts/clean-release.mjs",
    "import:rules": "node scripts/import-rules.mjs",
    "import:placement": "node scripts/import-placement-profiles.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:admin-ui": "node scripts/admin-ui-visual-check.mjs",
    "acceptance:offline": "node scripts/acceptance-offline-store.mjs",
    "demo:lighting-data": "node scripts/generate-demo-lighting-data.mjs",
    "demo:lighting-data:check": "node scripts/validate-demo-lighting-data.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "naive-ui": "2.44.1",
    "pinia": "^4.1.0",
    "three": "^0.186.1",
    "vue": "^3.5.44",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "electron": "38.7.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "build": {
    "npmRebuild": false,
    "compression": "store",
    "electronDist": "node_modules/electron/dist",
    "appId": "com.qone.smart-home-store",
    "productName": "QoneHome·智能家电门店管理系统",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "shared/**/*",
      "home/**/*",
      "app/**/*",
      "data/**/*",
      "electron/**/*",
      "runtime/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "server/**/*",
      "shared/**/*",
      "home/**/*",
      "app/**/*",
      "data/**/*",
      "dist/**/*",
      "runtime/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "QoneHome",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "智能家电门店管理系统",
      "artifactName": "QoneHome-Setup-${version}.${ext}",
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "QoneHome-Portable-${version}.${ext}"
    }
  }
}
